    <!-- RECENCY RULES -->
    <!-- ===================== -->

    <record id="rfm_rule_recency_5" model="rfm.rule">
        <field name="name">Recency ≤ 30 days</field>
        <field name="metric">recency</field>
        <field name="value_from">0</field>
        <field name="value_to">30</field>
        <field name="score">5</field>
        <field name="sequence">1</field>
        <field name="active">True</field>
    </record>

