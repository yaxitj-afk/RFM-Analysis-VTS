<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="action_partner_compute_rfm" model="ir.actions.server">
        <field name="name">Compute RFM</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="binding_model_id" ref="base.model_res_partner"/>
        <field name="state">code</field>
        <field name="code"><![CDATA[
if records:
    records.compute_rfm()
else:
    env['res.partner'].search([('customer_rank', '>', 0)]).compute_rfm()
        ]]></field>
    </record>
</odoo>
