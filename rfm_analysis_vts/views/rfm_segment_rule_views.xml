<?xml version="1.0" encoding="UTF-8"?>

<odoo>
    <record id="view_rfm_segment_rule_tree" model="ir.ui.view">
        <field name="name">rfm.segment.rule.tree</field>
        <field name="model">rfm.segment.rule</field>
        <field name="arch" type="xml">
            <list >
                <field name="sequence"  widget="handle" width="1px"/>
                <field name="name" width="360px"/>
                <field name="segment_id" width="160px"/>
                <field name="recency_min" width="120px"/>
                <field name="frequency_min" width="120px"/>
                <field name="monetary_min" width="120px"/>
                <field name="active" width="80px"/>
            </list>
        </field>
    </record>

    <record id="view_rfm_segment_rule_form" model="ir.ui.view">
        <field name="name">rfm.segment.rule.form</field>
        <field name="model">rfm.segment.rule</field>
        <field name="arch" type="xml">
            <form create="false">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="segment_id"/>
                        <field name="recency_min"/>
                        <field name="frequency_min"/>
                        <field name="monetary_min"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_rfm_segment_rule" model="ir.actions.act_window">
        <field name="name">RFM Segments</field>
        <field name="res_model">rfm.segment.rule</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
