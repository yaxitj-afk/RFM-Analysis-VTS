<?xml version="1.0" encoding="UTF-8"?>

<odoo>

    <record id="view_rfm_rule_tree" model="ir.ui.view">
        <field name="name">rfm.rule.tree</field>
        <field name="model">rfm.rule</field>
        <field name="arch" type="xml">
            <list default_group_by="metric">
                <field name="name" width="220px"/>
                <field name="metric" width="160px"/>
                <field name="value_from" width="120px"/>
                <field name="value_to" width="120px"/>
                <field name="score" width="120px"/>
                <field name="active" width="120px"/>
            </list>
        </field>
    </record>

    <record id="view_rfm_rule_form" model="ir.ui.view">
        <field name="name">rfm.rule.form</field>
        <field name="model">rfm.rule</field>
        <field name="arch" type="xml">
            <form create="false">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="metric"/>
                        <field name="value_from"/>
                        <field name="value_to"/>
                        <field name="partner_category_ids" widget="many2many_tags"/>
                        <field name="score"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_rfm_rule" model="ir.actions.act_window">
        <field name="name">RFM Scoring Rules</field>
        <field name="res_model">rfm.rule</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
