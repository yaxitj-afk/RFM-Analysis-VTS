    <!-- RFM SEGMENT LIST -->
    <record id="view_rfm_segment_list" model="ir.ui.view">
        <field name="name">rfm.segment.dashboard.list</field>
        <field name="model">rfm.segment.dashboard</field>
        <field name="arch" type="xml">
            <list string="RFM Segments">
                <field name="segment_id"/>
                <field name="customer_count"/>
                <field name="order_count"/>
            </list>
        </field>
    </record>

    <!-- DASHBOARD ACTION -->
    <record id="action_rfm_segment_dashboard" model="ir.actions.act_window">
        <field name="name">RFM Dashboard</field>
        <field name="res_model">rfm.segment.dashboard</field>
        <field name="view_mode">kanban,list</field>
        <field name="view_id" ref="view_rfm_segment_kanban"/>
        <field name="target">current</field>
    </record>


    <!-- LEADS ACTION -->
    <record id="action_segment_leads" model="ir.actions.act_window">
        <field name="name">Leads</field>
        <field name="res_model">crm.lead</field>
        <field name="view_mode">list,form</field>
        <field name="domain">
            [('partner_id.rfm_segment_id', '=', context.get('segment_id'))]
        </field>
    </record>


    <!-- QUOTATIONS ACTION -->
    <record id="action_segment_quotations" model="ir.actions.act_window">
        <field name="name">Quotations</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">list,form</field>
        <field name="domain">
            [
            ('state', 'in', ('draft','sent')),
            ('partner_id.rfm_segment_id', '=', context.get('segment_id'))
            ]
        </field>
    </record>

</odoo>
